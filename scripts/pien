recipe_help() {
  cat <<'USAGE'
pien recipe - copyable pi-en integration recipes

Usage:
  pien recipe flake-agent-shell

Commands:
  flake-agent-shell  Print the canonical non-mutating flake .#agent shell recipe

Recipes only print guidance. They do not modify project files.
USAGE
}

flake_agent_shell_recipe() {
  cat <<'RECIPE'
# pien recipe flake-agent-shell

Purpose: make `nix develop .#agent` the pi-en-aware agent entrypoint for
an existing flake without replacing project devShells, packages, FHS shells,
containers, or project-specific shell policy. Pi-en-integrated projects should
always expose devShells.<system>.agent; it can be a dedicated mkPiShell shell or
an alias when the default shell is already pi-en-aware. This command is
informational only and does not read, edit, or write project files.

1. Add the pi-en input next to existing inputs:

```nix
inputs = {
  # existing inputs...

  # Local checkout for active pi-en development:
  pi-en.url = "git+file:///home/me/src/pi-en";
  # Shared/pinned alternative:
  # pi-en.url = "github:u2up/pi-en";

  # Follow the project's pins when those inputs exist.
  pi-en.inputs.nixpkgs.follows = "nixpkgs";
  pi-en.inputs.flake-utils.follows = "flake-utils";
};
```

2. Include `pi-en` in the outputs argument set:

```nix
outputs = { self, nixpkgs, flake-utils, pi-en, ... }:
  # existing outputs...
```

3. Preserve existing devShells and choose one `agent` pattern.

Dedicated agent shell pattern:

```nix
let
  pkgs = import nixpkgs { inherit system; };
in {
  # If this flake already has devShells.${system}, keep that expression on
  # the left side of `//` instead of reading this output back through self.
  # For example, move existing shells into this attrset or replace it with
  # the flake's current devShells.${system} expression.
  devShells.${system} = {
    # default = pkgs.mkShell { ...existing project shell...; };
  } // {
    agent = pi-en.lib.mkPiShell {
      inherit pkgs;

      # Set to true, or omit because true is the default, when this project
      # uses pi-en-bootstrap-coordination or pi-en-coord-* helpers.
      includeCoordinationHelpers = false;

      extraPackages = with pkgs; [
        # Project-specific tools Pi should see inside Bubblewrap, for example:
        # gnumake
        # nodejs
        # python3
      ];

      shellHook = ''
        echo "Pi agent shell loaded. Use 'pien' or 'pien shell'."
      '';
    };
  };
}
```

Alias pattern when the default shell is already pi-en-aware:

```nix
let
  pkgs = import nixpkgs { inherit system; };
  existingDevShells = {
    default = pi-en.lib.mkPiShell {
      inherit pkgs;
      includeCoordinationHelpers = true;
      extraPackages = with pkgs; [ ];
    };
  };
in {
  devShells.${system} = existingDevShells // {
    # Keep `nix develop .#agent` stable without replacing the default shell.
    agent = existingDevShells.default;
  };
}
```

For flakes that already construct `devShells.${system}` with mapAttrs, an FHS
builder, flake-parts, devenv, or a container output, keep that structure and
append only the dedicated `// { agent = pi-en.lib.mkPiShell { ... }; }` merge
or alias `// { agent = existingDevShells.default; }` at the smallest safe point.
Do not create a project-native shell that only happens to be named `agent`; a
pi-en-aware shell must expose `pien` and the pi-en runtime through
`pi-en.lib.mkPiShell` or equivalent pi-en packages.

Coordination variants:
- `includeCoordinationHelpers = true;` includes `pien coord ...`,
  pi-en-bootstrap-coordination, pi-en-coord-*, and role orchestration helpers.
- `includeCoordinationHelpers = false;` keeps a smaller runtime shell when the
  project does not use Git-backed coordination.

Suggested prompt when asking Pi to modify an external complex flake:

```text
Use the pi-en-flake-integration skill. Modify flake.nix to add
devShells.${system}.agent using pi-en.lib.mkPiShell. Add pi-en as a
flake input, add it to outputs, preserve existing devShells and package
outputs, and do not create a project-native agentProfile unless I
explicitly ask for one.
```

After editing manually, run:

```bash
nix flake lock --update-input pi-en
nix develop .#agent
pien --help
```
RECIPE
}

update_help() {
  cat <<'USAGE'
pien update - update a non-Nix Pi-en installation

Usage:
  pien update [--prefix PREFIX] [--check-deps]
  pien update --url URL --ref REF [--prefix PREFIX]
  pien update [--ref REF] [--repo OWNER/REPO] [--artifact-url URL]
  pien update --help

Options:
  --prefix PREFIX      Installed prefix to update; default: $PREFIX or ~/.local
  --check-deps         Check host tools before updating
  --url URL            Git repository URL or local path to install from
  --ref REF            Branch, tag, or COMMIT@BRANCH to install
  --repo OWNER/REPO    GitHub repository for archive --ref
  --artifact-url URL   Archive URL or local archive path to fetch
  -h, --help           Show this help

When pi-en-update is installed, this command delegates to it. From a direct
checkout, pass explicit source arguments such as --url with --ref, --ref for an
archive install, or --artifact-url; pien then delegates to pi-en-install-non-nix
with those arguments.
USAGE
}

completion_help() {
  cat <<'USAGE'
pien completion - shell completion commands

Usage:
  pien completion bash

Commands:
  bash  Print a sourceable Bash completion script for pien
USAGE
}

bash_completion() {
  cat <<'COMPLETION'
_pien() {
  local cur prev words cword command_path option_words path_options launcher_options raw_marker_seen i
  COMPREPLY=()
  if declare -F _init_completion >/dev/null 2>&1; then
    _init_completion || return
  else
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    words=("${COMP_WORDS[@]}")
    cword=$COMP_CWORD
  fi

  _pien_comp_words() {
    compgen -W "$1" -- "$cur"
  }

  launcher_options="--runtime --runtime= --flake --flake= --devshell --devshell= --help -h"
  path_options="--coord-dir --coordination-dir --designs-dir --output -o --prefix --artifact-url --flake --domain-generated-file"

  raw_marker_seen=false
  for ((i = 1; i < cword; i++)); do
    if [ "${words[i]}" = "--raw" ]; then
      raw_marker_seen=true
      break
    fi
  done

  command_path=""
  case "${words[1]:-}" in
    coord)
      command_path="coord"
      case "${words[2]:-}" in
        rules) [ "${words[3]:-}" = "upgrade" ] && command_path="coord rules upgrade" ;;
        requirements)
          case "${words[3]:-}" in
            generate) command_path="coord requirements generate" ;;
            coverage) command_path="coord requirements coverage" ;;
          esac
          ;;
        bootstrap|init|clone|status|list|show|new|claim|done|review|verify|close|pull|push|lint|repo)
          command_path="coord ${words[2]}"
          ;;
      esac
      ;;
    run|raw|shell) command_path="${words[1]}" ;;
    sandbox) command_path="sandbox" ;;
    roles)
      command_path="roles"
      [ "${words[2]:-}" = "serial" ] && command_path="roles serial"
      ;;
    recipe)
      command_path="recipe"
      [ "${words[2]:-}" = "flake-agent-shell" ] && command_path="recipe flake-agent-shell"
      ;;
    install|update|uninstall|completion|diagnostics|version|help) command_path="${words[1]}" ;;
  esac

  if [ "$prev" = "--runtime" ]; then
    if ! $raw_marker_seen; then
      case "$command_path" in
        run|shell|"") COMPREPLY=( $(_pien_comp_words "host nix auto") ) ;;
      esac
    fi
    return 0
  fi
  if [[ " $path_options " == *" $prev "* ]]; then
    compopt -o default 2>/dev/null || true
    return 0
  fi

  if [[ "$cur" == -* ]]; then
    case "$command_path" in
      coord\ status) option_words="--coord-dir --repo-id --porcelain --help -h" ;;
      coord\ list) option_words="--coord-dir --repo-id --all-repos --show-repo --category --show-category --group-by-category --help -h" ;;
      coord\ show) option_words="--coord-dir --path --help -h" ;;
      coord\ rules\ upgrade) option_words="--coord-dir --agent-id --role --preview --no-pull --push --help -h" ;;
      coord\ requirements\ generate) option_words="--project --coordination-dir --coord-dir --output -o --help -h" ;;
      coord\ requirements\ coverage) option_words="--project --coordination-dir --designs-dir --output -o --help -h" ;;
      coord\ claim|coord\ done|coord\ review|coord\ verify|coord\ close) option_words="--coord-dir --agent-id --role --result --message --no-pull --no-push --force --pass --fail --help -h" ;;
      coord\ bootstrap) option_words="--project-root --root --remote --project --project-key --repo-id --register-repo --implementation-remote --domain-generated-file --generated-requirements-docs --dir --agent-id --bare-only --print-only --dry-run --no-status --help -h" ;;
      coord\ pull|coord\ push|coord\ lint|coord\ repo|coord\ init|coord\ clone|coord\ new) option_words="--coord-dir --repo-id --help -h" ;;
      run|shell|"")
        if $raw_marker_seen; then
          option_words="--help -h"
        else
          option_words="$launcher_options"
        fi
        ;;
      raw) option_words="--help -h" ;;
      roles\ serial) option_words="--role --limit --coord-dir --help -h" ;;
      recipe\ flake-agent-shell) option_words="--help -h" ;;
      install) option_words="--prefix --check-deps --url --ref --repo --artifact-url --help -h" ;;
      update) option_words="--prefix --check-deps --url --ref --repo --artifact-url --help -h" ;;
      uninstall) option_words="--prefix --help -h" ;;
      *) option_words="--help -h" ;;
    esac
    COMPREPLY=( $(_pien_comp_words "$option_words") )
    return 0
  fi

  case "$cword" in
    1) COMPREPLY=( $(_pien_comp_words "run raw shell sandbox coord roles recipe install update uninstall diagnostics version help completion") ); return 0 ;;
  esac

  case "${words[1]:-}" in
    sandbox)
      [ "$cword" -eq 2 ] && COMPREPLY=( $(_pien_comp_words "shell") )
      ;;
    coord)
      case "${words[2]:-}" in
        rules) [ "$cword" -eq 3 ] && COMPREPLY=( $(_pien_comp_words "upgrade") ) ;;
        requirements) [ "$cword" -eq 3 ] && COMPREPLY=( $(_pien_comp_words "generate coverage") ) ;;
        *) [ "$cword" -eq 2 ] && COMPREPLY=( $(_pien_comp_words "bootstrap init clone status list show new claim done review verify close pull push lint repo rules requirements") ) ;;
      esac
      ;;
    roles)
      [ "$cword" -eq 2 ] && COMPREPLY=( $(_pien_comp_words "serial") )
      ;;
    recipe)
      [ "$cword" -eq 2 ] && COMPREPLY=( $(_pien_comp_words "flake-agent-shell") )
      ;;
    completion)
      [ "$cword" -eq 2 ] && COMPREPLY=( $(_pien_comp_words "bash") )
      ;;
    help)
      case "${words[2]:-}" in
        "") [ "$cword" -eq 2 ] && COMPREPLY=( $(_pien_comp_words "run raw shell sandbox coord roles recipe install update uninstall diagnostics version completion") ) ;;
        coord)
          case "${words[3]:-}" in
            "") [ "$cword" -eq 3 ] && COMPREPLY=( $(_pien_comp_words "bootstrap init clone status list show new claim done review verify close pull push lint repo rules requirements") ) ;;
            rules) [ "$cword" -eq 4 ] && COMPREPLY=( $(_pien_comp_words "upgrade") ) ;;
            requirements) [ "$cword" -eq 4 ] && COMPREPLY=( $(_pien_comp_words "generate coverage") ) ;;
          esac
          ;;
        roles) [ "$cword" -eq 3 ] && COMPREPLY=( $(_pien_comp_words "serial") ) ;;
        recipe) [ "$cword" -eq 3 ] && COMPREPLY=( $(_pien_comp_words "flake-agent-shell") ) ;;
        completion) [ "$cword" -eq 3 ] && COMPREPLY=( $(_pien_comp_words "bash") ) ;;
      esac
      ;;
  esac
}
complete -F _pien pien
COMPLETION
}

resolve_command() {
  local name="$1"
  case "$name" in
    pi-en|pi-en-shell)
      if [ -x "$repo_root/$name" ]; then
        printf '%s\n' "$repo_root/$name"
        return 0
      fi
      ;;
  esac
  if [ -x "$script_dir/$name" ]; then
    printf '%s\n' "$script_dir/$name"
    return 0
  fi
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  echo "pien: required command not found: $name" >&2
  return 127
}

exec_command() {
  local name="$1"
  shift
  local command_path
  command_path="$(resolve_command "$name")"
  exec "$command_path" "$@"
}

run_command_help() {
  local name="$1"
  shift
  local command_path
  command_path="$(resolve_command "$name")"
  "$command_path" --help
}

coord_leaf_command_name() {
  case "$1" in
    bootstrap) printf '%s\n' pi-en-bootstrap-coordination ;;
    init|clone|status|list|new|claim|done|review|verify|close|pull|push|lint|repo) printf 'pi-en-coord-%s\n' "$1" ;;
    show) printf '%s\n' pi-en-coord-cat ;;
    *) return 1 ;;
  esac
}

help_dispatch() {
  case "${1:-}" in
    "") usage ;;
    coord)
      shift
      case "${1:-}" in
        ""|-h|--help) coord_help ;;
        rules)
          shift
          case "${1:-}" in
            ""|-h|--help) coord_rules_help ;;
            upgrade) run_command_help pi-en-coord-upgrade-rules ;;
            *) unknown help coord rules "$1" ;;
          esac
          ;;
        requirements)
          shift
          case "${1:-}" in
            ""|-h|--help) coord_requirements_help ;;
            generate) run_command_help pi-en-coord-generate-requirements ;;
            coverage) run_command_help pi-en-coord-generate-requirements-coverage ;;
            *) unknown help coord requirements "$1" ;;
          esac
          ;;
        *)
          local leaf
          if leaf="$(coord_leaf_command_name "$1")"; then
            run_command_help "$leaf"
          else
            unknown help coord "$1"
          fi
          ;;
      esac
      ;;
    roles)
      shift
      case "${1:-}" in
        ""|-h|--help) roles_help ;;
        serial) run_command_help pi-en-serial-roles ;;
        *) unknown help roles "$1" ;;
      esac
      ;;
    recipe)
      shift
      case "${1:-}" in
        ""|-h|--help) recipe_help ;;
        flake-agent-shell) flake_agent_shell_recipe ;;
        *) unknown help recipe "$1" ;;
      esac
      ;;
    completion)
      shift
      case "${1:-}" in
        ""|-h|--help) completion_help ;;
        bash) completion_help ;;
        *) unknown help completion "$1" ;;
      esac
      ;;
    run) run_command_help pi-en ;;
    raw) run_command_help pi-en ;;
    shell) run_command_help pi-en-shell ;;
    sandbox) run_command_help pi-en-bwrap ;;
    install) run_command_help pi-en-install-non-nix ;;
    update)
      if command -v pi-en-update >/dev/null 2>&1; then
        run_command_help pi-en-update
      else
        update_help
      fi
      ;;
    diagnostics) diagnostics_output ;;
    version) version_output ;;
    uninstall)
      if command -v pi-en-uninstall >/dev/null 2>&1; then
        run_command_help pi-en-uninstall
      else
        run_command_help pi-en-install-non-nix
      fi
      ;;
    *) unknown help "$1" ;;
  esac
}

unknown() {
  echo "pien: unknown command: $*" >&2
  echo "Try 'pien help'." >&2
  exit 2
}

if [ "$#" -eq 0 ]; then
  if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
    sandbox_outer_only run
  fi
  exec_command pi-en
fi

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --version|version)
    version_output
    exit 0
    ;;
  diagnostics|diagnose|diag)
    diagnostics_output
    exit 0
    ;;
  --runtime|--runtime=*|--flake|--flake=*|--devshell|--devshell=*|--raw)
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only "$@"
    fi
    exec_command pi-en "$@"
    ;;
  help)
    shift
    help_dispatch "$@"
    exit 0
    ;;
  --)
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only "$@"
    fi
    shift
    exec_command pi-en "$@"
    ;;
  run)
    shift
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only run "$@"
    fi
    exec_command pi-en "$@"
    ;;
  raw)
    shift
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only raw "$@"
    fi
    exec_command pi-en --raw "$@"
    ;;
  shell)
    shift
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only shell "$@"
    fi
    exec_command pi-en-shell "$@"
    ;;
  sandbox)
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only sandbox "${@:2}"
    fi
    shift
    case "${1:-}" in
      -h|--help) run_command_help pi-en-bwrap; exit 0 ;;
      shell)
        shift
        exec_command pi-en-bwrap --shell "$@"
        ;;
    esac
    exec_command pi-en-bwrap "$@"
    ;;
  coord)
    shift
    case "${1:-}" in
      ""|-h|--help) coord_help; exit 0 ;;
      bootstrap) shift; exec_command pi-en-bootstrap-coordination "$@" ;;
      init|clone|status|list|new|claim|done|review|verify|close|pull|push|lint|repo)
        subcommand="$1"
        shift
        exec_command "pi-en-coord-$subcommand" "$@"
        ;;
      show) shift; exec_command pi-en-coord-cat "$@" ;;
      rules)
        shift
        case "${1:-}" in
          ""|-h|--help) coord_rules_help; exit 0 ;;
          upgrade) shift; exec_command pi-en-coord-upgrade-rules "$@" ;;
          *) unknown coord rules "${1:-}" ;;
        esac
        ;;
      requirements)
        shift
        case "${1:-}" in
          ""|-h|--help) coord_requirements_help; exit 0 ;;
          generate) shift; exec_command pi-en-coord-generate-requirements "$@" ;;
          coverage) shift; exec_command pi-en-coord-generate-requirements-coverage "$@" ;;
          *) unknown coord requirements "${1:-}" ;;
        esac
        ;;
      *) unknown coord "${1:-}" ;;
    esac
    ;;
  roles)
    shift
    case "${1:-}" in
      ""|-h|--help) roles_help; exit 0 ;;
      serial)
        shift
        if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
          case "${1:-}" in
            -h|--help) run_command_help pi-en-serial-roles; exit 0 ;;
            *) sandbox_outer_only roles serial "$@" ;;
          esac
        fi
        exec_command pi-en-serial-roles "$@"
        ;;
      *) unknown roles "${1:-}" ;;
    esac
    ;;
  recipe)
    shift
    case "${1:-}" in
      ""|-h|--help) recipe_help; exit 0 ;;
      flake-agent-shell)
        shift
        case "${1:-}" in
          "") flake_agent_shell_recipe; exit 0 ;;
          -h|--help) flake_agent_shell_recipe; exit 0 ;;
          *) unknown recipe flake-agent-shell "$@" ;;
        esac
        ;;
      *) unknown recipe "${1:-}" ;;
    esac
    ;;
  install)
    shift
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only install "$@"
    fi
    exec_command pi-en-install-non-nix "$@"
    ;;
  update)
    shift
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only update "$@"
    fi
    case "${1:-}" in
      -h|--help) help_dispatch update; exit 0 ;;
    esac
    if command -v pi-en-update >/dev/null 2>&1; then
      exec_command pi-en-update "$@"
    fi
    has_source_arg=0
    for arg in "$@"; do
      case "$arg" in
        --url|--url=*|--ref|--ref=*|--repo|--repo=*|--artifact-url|--artifact-url=*) has_source_arg=1 ;;
      esac
    done
    if [ "$has_source_arg" = "0" ]; then
      echo "pien: update from a direct checkout requires --url/--ref, --ref, or --artifact-url" >&2
      echo "pien: installed prefixes can use pi-en-update to reuse stored install origin metadata." >&2
      exit 2
    fi
    export PI_EN_INSTALL_UPDATE_WRAPPER=1
    export PI_EN_INSTALL_PREFER_REMOTE=1
    exec_command pi-en-install-non-nix "$@"
    ;;
  uninstall)
    shift
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only uninstall "$@"
    fi
    if command -v pi-en-uninstall >/dev/null 2>&1; then
      exec_command pi-en-uninstall "$@"
    fi
    exec_command pi-en-install-non-nix --uninstall "$@"
    ;;
  completion)
    shift
    case "${1:-}" in
      ""|-h|--help) completion_help; exit 0 ;;
      bash)
        shift
        [ "$#" -eq 0 ] || unknown completion bash "$@"
        bash_completion
        ;;
      *) unknown completion "${1:-}" ;;
    esac
    ;;
  *)
    if [ "${PI_EN_INSIDE_SANDBOX:-0}" = "1" ]; then
      sandbox_outer_only "$@"
    fi
    exec_command pi-en "$@"
    ;;
esac
