#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/.." 2>/dev/null && pwd -P || printf '%s' "$script_dir")"

usage() {
  cat <<'USAGE'
pien - pi-en command namespace

Usage:
  pien [launcher options] [pi args...]
  pien [launcher options] -- [pi args...]
  pien run [launcher options] [pi args...]
  pien [launcher options] --raw -- [pi args...]
  pien raw -- [pi args...]
  pien shell [launcher options] [shell args...]
  pien sandbox [pi args...]
  pien sandbox shell [shell args...]
  pien coord <command> [args...]
  pien roles serial [args...]
  pien recipe flake-agent-shell
  pien install [args...]
  pien update [args...]
  pien uninstall [args...]
  pien completion bash
  pien diagnostics
  pien version
  pien help [command...]

Commands:
  run                 Run pi-en (existing command: pi-en)
  raw                 Run pi-en with --raw (existing command: pi-en --raw)
  shell               Run a pi-en shell (existing command: pi-en-shell)
  sandbox             Run the sandbox helper (existing command: pi-en-bwrap)
  coord               Coordination helpers (existing commands: pi-en-coord-*)
  roles serial        Serial role orchestrator (existing command: pi-en-serial-roles)
  recipe              Print non-mutating integration recipes
  install             Non-Nix installer (existing command: pi-en-install-non-nix)
  update              Non-Nix updater (existing command: pi-en-update)
  uninstall           Non-Nix uninstaller (existing command: pi-en-uninstall)
  completion bash     Print Bash completion for pien
  diagnostics         Print sandbox/runtime diagnostics without launching Pi
  version             Print pi-en version information
  help                Show help for pien commands

Launcher options for the default, run, shell, and pi-en --raw forms:
  --runtime host|nix|auto  Select host tools, Nix-backed runtime, or auto.
  --flake REF              Select the Nix flake used by --runtime nix|auto.
  --devshell NAME          Select the Nix devShell name for --runtime nix|auto.

Environment variables provide the same defaults: PI_EN_RUNTIME, PI_EN_FLAKE,
and PI_EN_NIX_DEVSHELL. CLI options win over environment values. These
launcher options are passed to pi-en or pi-en-shell. For raw mode, put
launcher options before --raw (for example, 'pien --runtime host --raw -- ...');
the 'pien raw' namespace remains a thin 'pi-en --raw' dispatcher. Coordination,
recipe, install, update, uninstall, and sandbox commands have separate option sets.

Use 'pien -- ...' to pass a first Pi argument that would otherwise be
parsed as a pien subcommand.
USAGE
}

version_output() {
  if [ -n "${PI_EN_VERSION:-}" ]; then
    printf 'pien %s\n' "$PI_EN_VERSION"
  else
    printf 'pien (pi-en checkout)\n'
  fi
}

diagnostics_output() {
  printf 'PI_EN_INSIDE_SANDBOX=%s\n' "${PI_EN_INSIDE_SANDBOX:-0}"
  printf 'PI_EN_COORD_DIR=%s\n' "${PI_EN_COORD_DIR:-}"
  printf 'PI_EN_COORD_REMOTE=%s\n' "${PI_EN_COORD_REMOTE:-}"
  printf 'PI_EN_NIX_SANDBOX_COMMAND_PATH=%s\n' "${PI_EN_NIX_SANDBOX_COMMAND_PATH:-}"
  if command -v pien >/dev/null 2>&1; then
    printf 'pien=%s\n' "$(command -v pien)"
  fi
  if command -v pi-en-coord-status >/dev/null 2>&1; then
    printf 'coordination_helpers=available\n'
  else
    printf 'coordination_helpers=unavailable\n'
  fi
}

sandbox_outer_only() {
  echo "pien: '$*' must be run from the outer terminal, not from inside Pi's sandbox." >&2
  echo "pien: inside the sandbox, use 'pien help', 'pien diagnostics', 'pien recipe ...', or 'pien coord ...'." >&2
  exit 2
}

coord_help() {
  cat <<'USAGE'
pien coord - coordination command namespace

Usage:
  pien coord <command> [args...]
  pien coord rules upgrade [args...]
  pien coord requirements generate [args...]
  pien coord requirements coverage [args...]

Commands:
  bootstrap              Existing command: pi-en-bootstrap-coordination
  init                   Existing command: pi-en-coord-init
  clone                  Existing command: pi-en-coord-clone
  status                 Existing command: pi-en-coord-status
  list                   Existing command: pi-en-coord-list
  show                   Existing command: pi-en-coord-cat
  new                    Existing command: pi-en-coord-new
  claim                  Existing command: pi-en-coord-claim
  done                   Existing command: pi-en-coord-done
  review                 Existing command: pi-en-coord-review
  verify                 Existing command: pi-en-coord-verify
  close                  Existing command: pi-en-coord-close
  pull                   Existing command: pi-en-coord-pull
  push                   Existing command: pi-en-coord-push
  lint                   Existing command: pi-en-coord-lint
  repo                   Existing command: pi-en-coord-repo
  rules upgrade          Existing command: pi-en-coord-upgrade-rules
  requirements generate  Existing command: pi-en-coord-generate-requirements
  requirements coverage  Existing command: pi-en-coord-generate-requirements-coverage

Use 'pien help coord <command>' or 'pien coord <command> --help' for
leaf command help.
USAGE
}

