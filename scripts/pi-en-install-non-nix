#!/usr/bin/env bash
set -euo pipefail

command_names=(
  pien
  pi-en
  pi-en-shell
  pi-en-bwrap
  pi-en-bootstrap-coordination
  pi-en-coord-init
  pi-en-coord-clone
  pi-en-coord-status
  pi-en-coord-list
  pi-en-coord-cat
  pi-en-coord-pull
  pi-en-coord-push
  pi-en-coord-new
  pi-en-coord-repo
  pi-en-coord-claim
  pi-en-coord-done
  pi-en-coord-review
  pi-en-coord-verify
  pi-en-coord-close
  pi-en-coord-lint
  pi-en-coord-generate-requirements
  pi-en-coord-generate-requirements-coverage
  pi-en-coord-upgrade-rules
  pi-en-serial-roles
  pi-en-install-non-nix
  pi-en-update
  pi-en-uninstall
)

removed_command_names=(
  pi-start
  pi-bwrap
  bootstrap-coordination
  agent-coord-init
  agent-coord-clone
  agent-coord-status
  agent-coord-list
  agent-coord-cat
  agent-coord-pull
  agent-coord-push
  agent-coord-new
  agent-coord-repo
  agent-coord-claim
  agent-coord-done
  agent-coord-review
  agent-coord-verify
  agent-coord-close
  agent-coord-lint
  agent-coord-generate-requirements
  agent-coord-generate-requirements-coverage
  agent-coord-upgrade-rules
  pi-serial-roles
  install-non-nix
)

usage() {
  cat <<'USAGE'
pi-en-install-non-nix - install pi-en for host-runtime use without Nix

Usage:
  scripts/pi-en-install-non-nix [--prefix PREFIX] [--check-deps]
  scripts/pi-en-install-non-nix --url URL --ref REF [--prefix PREFIX]
  scripts/pi-en-install-non-nix [--ref REF] [--repo OWNER/REPO] [--artifact-url URL]
  scripts/pi-en-install-non-nix --uninstall [--prefix PREFIX]
  scripts/pi-en-install-non-nix --help

Options:
  --prefix PREFIX      Install prefix; default: $PREFIX or ~/.local
  --check-deps         Check host tools before installing
  --url URL            Git repository URL or local path to install from; used
                       with --ref and resolved before local payload discovery
  --ref REF            With --url, check out a branch, tag, or COMMIT@BRANCH.
                       Without --url, fetch and install a repository archive
                       when no local payload is available; --ref main is
                       latest/dev
  --repo OWNER/REPO    GitHub repository for archive --ref; default: u2up/pi-en
  --artifact-url URL   Archive URL or local archive path to fetch instead of
                       constructing a GitHub archive URL
  --uninstall          Remove files listed in the installed manifest
  -h, --help           Show this help

The installer copies pi-en scripts and support data under
PREFIX/share/pi-en, installs wrapper commands under PREFIX/bin, and writes a
manifest that pi-en-uninstall can use later. It does not install or pin host
runtime tools; use the Nix flake/devshell for a pinned runtime.
USAGE
}

update_usage() {
  cat <<'USAGE'
pi-en-update - update a non-Nix Pi-en installation

Usage:
  pi-en-update [--prefix PREFIX] [--check-deps]
  pi-en-update --url URL --ref REF [--prefix PREFIX]
  pi-en-update [--ref REF] [--repo OWNER/REPO] [--artifact-url URL]
  pi-en-update --help

Options:
  --prefix PREFIX      Installed prefix to update; default: $PREFIX or ~/.local
  --check-deps         Check host tools before updating
  --url URL            Git repository URL or local path to update from
  --ref REF            Git branch, tag, COMMIT@BRANCH, or archive ref
  --repo OWNER/REPO    GitHub repository for archive --ref; default: u2up/pi-en
  --artifact-url URL   Archive URL or local archive path to fetch instead
  -h, --help           Show this help

Packaged pi-en-update applies explicit source options by delegating to the
non-Nix installer. Non-Nix installed pi-en-update wrappers also reuse stored
Git install origin metadata when source options are omitted.
USAGE
}

prefix="${PREFIX:-$HOME/.local}"
check_deps=0
uninstall=0
remote_ref=""
git_url=""
remote_repo="u2up/pi-en"
artifact_url=""
temp_source_dir=""
prefer_remote="${PI_EN_INSTALL_PREFER_REMOTE:-0}"
if [ "${PI_EN_INSTALL_UPDATE_WRAPPER:-0}" = "1" ]; then
  for pi_en_arg in "$@"; do
    case "$pi_en_arg" in
      -h|--help) update_usage; exit 0 ;;
    esac
  done
fi
while [ "$#" -gt 0 ]; do
  case "$1" in
    --prefix)
      [ "$#" -ge 2 ] || { echo "pi-en-install-non-nix: --prefix requires a value" >&2; exit 2; }
      prefix="$2"
      shift 2
      ;;
    --prefix=*)
      prefix="${1#--prefix=}"
      shift
      ;;
    --check-deps)
      check_deps=1
      shift
      ;;
    --url)
      [ "$#" -ge 2 ] || { echo "pi-en-install-non-nix: --url requires a value" >&2; exit 2; }
      git_url="$2"
      shift 2
      ;;
    --url=*)
      git_url="${1#--url=}"
      shift
      ;;
    --ref)
      [ "$#" -ge 2 ] || { echo "pi-en-install-non-nix: --ref requires a value" >&2; exit 2; }
      remote_ref="$2"
      shift 2
      ;;
    --ref=*)
      remote_ref="${1#--ref=}"
      shift
      ;;
    --repo)
      [ "$#" -ge 2 ] || { echo "pi-en-install-non-nix: --repo requires a value" >&2; exit 2; }
      remote_repo="$2"
      shift 2
      ;;
    --repo=*)
      remote_repo="${1#--repo=}"
      shift
      ;;
    --artifact-url)
      [ "$#" -ge 2 ] || { echo "pi-en-install-non-nix: --artifact-url requires a value" >&2; exit 2; }
      artifact_url="$2"
      shift 2
      ;;
    --artifact-url=*)
      artifact_url="${1#--artifact-url=}"
      shift
      ;;
    --uninstall)
      uninstall=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "pi-en-install-non-nix: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

case "$prefix" in
  /*) ;;
  *) prefix="$(pwd -P)/$prefix" ;;
esac

bin_dir="$prefix/bin"
share_dir="$prefix/share/pi-en"
completion_dir="$prefix/share/bash-completion/completions"
manifest="$share_dir/install-manifest"
origin_file="$share_dir/install-origin"

is_source_root() {
  local candidate="$1"
  [ -f "$candidate/scripts/pien" ] && \
    [ -f "$candidate/scripts/pi-en-launcher" ] && \
    [ -f "$candidate/scripts/pi-en-coord-lib.sh" ] && \
    [ -d "$candidate/role-manager" ] && \
    [ -d "$candidate/pi-skill-templates" ]
}

find_source_root() {
  local script_dir candidate
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  for candidate in "$(cd "$script_dir/.." && pwd -P)" "$script_dir" "$(pwd -P)"; do
    if is_source_root "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

find_unpacked_source_root() {
  local unpack_dir="$1" candidate
  if is_source_root "$unpack_dir"; then
    printf '%s\n' "$unpack_dir"
    return 0
  fi
  while IFS= read -r candidate; do
    if is_source_root "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(find "$unpack_dir" -mindepth 1 -maxdepth 2 -type d -print | sort)
  echo "pi-en-install-non-nix: downloaded archive does not contain pi-en release/source layout" >&2
  echo "pi-en-install-non-nix: expected scripts/, role-manager/, and pi-skill-templates/" >&2
  return 1
}

check_host_dependencies() {
  local missing=0 dep
  for dep in bash bwrap git jq node pi env realpath sed grep awk find sort mkdir cp rm chmod ln dirname basename mktemp tar; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      echo "pi-en-install-non-nix: missing host dependency: $dep" >&2
      missing=1
    fi
  done
  if [ "$missing" = "1" ]; then
    echo "pi-en-install-non-nix: install the missing host tools, or use the Nix runtime for pinned tools." >&2
    return 127
  fi
}

write_manifest() {
  local tmp_manifest="$manifest.tmp"
  : > "$tmp_manifest"
  for name in "${command_names[@]}"; do
    printf '%s\n' "$bin_dir/$name" >> "$tmp_manifest"
  done
  [ ! -f "$origin_file" ] || printf '%s\n' "$origin_file" >> "$tmp_manifest"
  find "$share_dir/scripts" "$share_dir/role-manager" "$share_dir/pi-skill-templates" \
    -mindepth 1 -type f -print | sort >> "$tmp_manifest"
  [ ! -f "$completion_dir/pien" ] || printf '%s\n' "$completion_dir/pien" >> "$tmp_manifest"
  find "$share_dir/scripts" "$share_dir/role-manager" "$share_dir/pi-skill-templates" \
    -depth -type d -print >> "$tmp_manifest"
  printf '%s\n' "$completion_dir" "$prefix/share/bash-completion" "$share_dir" "$prefix/share" "$bin_dir" >> "$tmp_manifest"
  mv "$tmp_manifest" "$manifest"
}

remove_empty_parents() {
  local dir
  for dir in "$share_dir/scripts" "$share_dir/role-manager" "$share_dir/pi-skill-templates" "$completion_dir" "$prefix/share/bash-completion" "$share_dir" "$prefix/share" "$bin_dir"; do
    rmdir "$dir" 2>/dev/null || true
  done
}

remove_obsolete_commands() {
  local name
  for name in "${removed_command_names[@]}"; do
    rm -f "$bin_dir/$name"
  done
}

run_uninstall() {
  if [ ! -f "$manifest" ]; then
    echo "pi-en-install-non-nix: manifest not found: $manifest" >&2
    exit 1
  fi
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      "$prefix"/*) ;;
      *) echo "pi-en-install-non-nix: refusing to remove path outside prefix: $path" >&2; exit 1 ;;
    esac
    if [ -d "$path" ]; then
      rmdir "$path" 2>/dev/null || true
    else
      rm -f "$path"
    fi
  done < "$manifest"
  rm -f "$manifest"
  remove_empty_parents
  echo "Removed pi-en files listed in $manifest"
}

shell_quote() {
  printf '%q' "$1"
}

install_wrapper() {
  local name="$1" target="$2"
  local bin_dir_q share_dir_q target_q
  bin_dir_q="$(shell_quote "$bin_dir")"
  share_dir_q="$(shell_quote "$share_dir")"
  target_q="$(shell_quote "$target")"
  cat > "$bin_dir/$name" <<EOF
#!/usr/bin/env bash
set -euo pipefail
pi_en_bin_dir=$bin_dir_q
pi_en_share_dir=$share_dir_q
pi_en_script_target=$target_q
if [ "\$(basename "\$0")" = "pi-en-shell" ]; then
  export PI_EN_SHELL_MODE=1
fi
export PATH="\$pi_en_bin_dir:\${PATH:-}"
export PI_EN_COORD_LIB="\${PI_EN_COORD_LIB:-\$pi_en_share_dir/scripts/pi-en-coord-lib.sh}"
export PI_EN_COORD_TEMPLATE_DIR="\${PI_EN_COORD_TEMPLATE_DIR:-\$pi_en_share_dir/pi-skill-templates/agent-coordination}"
export PI_EN_ROLE_MANAGER_PACKAGE="\${PI_EN_ROLE_MANAGER_PACKAGE:-\$pi_en_share_dir/role-manager}"
export PI_EN_PI_EN_BWRAP="\${PI_EN_PI_EN_BWRAP:-\$pi_en_bin_dir/pi-en-bwrap}"
exec /usr/bin/env bash "\$pi_en_share_dir/scripts/\$pi_en_script_target" "\$@"
EOF
  chmod +x "$bin_dir/$name"
}

install_uninstall_wrapper() {
  local prefix_q share_dir_q
  prefix_q="$(shell_quote "$prefix")"
  share_dir_q="$(shell_quote "$share_dir")"
  cat > "$bin_dir/pi-en-uninstall" <<EOF
#!/usr/bin/env bash
set -euo pipefail
pi_en_prefix=$prefix_q
pi_en_share_dir=$share_dir_q
exec /usr/bin/env bash "\$pi_en_share_dir/scripts/pi-en-install-non-nix" --uninstall --prefix "\$pi_en_prefix" "\$@"
EOF
  chmod +x "$bin_dir/pi-en-uninstall"
}

install_update_wrapper() {
  local prefix_q share_dir_q
  prefix_q="$(shell_quote "$prefix")"
  share_dir_q="$(shell_quote "$share_dir")"
  cat > "$bin_dir/pi-en-update" <<EOF
#!/usr/bin/env bash
set -euo pipefail
pi_en_prefix=$prefix_q
pi_en_share_dir=$share_dir_q
pi_en_origin_file="\$pi_en_share_dir/install-origin"
pi_en_origin_value() {
  local key="\$1" line
  [ -f "\$pi_en_origin_file" ] || return 1
  while IFS= read -r line || [ -n "\$line" ]; do
    case "\$line" in
      "\$key="*) printf '%s\\n' "\${line#*=}"; return 0 ;;
    esac
  done < "\$pi_en_origin_file"
  return 1
}
pi_en_update_usage() {
  cat <<'PI_EN_UPDATE_USAGE'
pi-en-update - update a non-Nix Pi-en installation

Usage:
  pi-en-update [--prefix PREFIX] [--check-deps]
  pi-en-update --url URL --ref REF [--prefix PREFIX]
  pi-en-update [--ref REF] [--repo OWNER/REPO] [--artifact-url URL]
  pi-en-update --help

Options:
  --prefix PREFIX      Installed prefix to update; default: stored prefix
  --check-deps         Check host tools before updating
  --url URL            Git repository URL or local path to update from
  --ref REF            Git branch, tag, COMMIT@BRANCH, or archive ref
  --repo OWNER/REPO    GitHub repository for archive --ref; default: u2up/pi-en
  --artifact-url URL   Archive URL or local archive path to fetch instead
  -h, --help           Show this help

When installed from Git, pi-en-update reuses stored install origin metadata
unless source options are passed explicitly.
PI_EN_UPDATE_USAGE
}
for pi_en_arg in "\$@"; do
  case "\$pi_en_arg" in
    -h|--help) pi_en_update_usage; exit 0 ;;
  esac
done
pi_en_has_url=0
pi_en_has_ref=0
pi_en_has_archive_source=0
for pi_en_arg in "\$@"; do
  case "\$pi_en_arg" in
    --url|--url=*) pi_en_has_url=1 ;;
    --ref|--ref=*) pi_en_has_ref=1 ;;
    --artifact-url|--artifact-url=*|--repo|--repo=*) pi_en_has_archive_source=1 ;;
  esac
done
pi_en_extra_args=()
if [ "\$pi_en_has_archive_source" = 0 ]; then
  pi_en_origin_source="\$(pi_en_origin_value source || true)"
  if [ "\$pi_en_origin_source" = git ]; then
    if [ "\$pi_en_has_url" = 0 ]; then
      pi_en_origin_url="\$(pi_en_origin_value url || true)"
      if [ -n "\$pi_en_origin_url" ]; then
        pi_en_extra_args+=(--url "\$pi_en_origin_url")
      fi
    fi
    if [ "\$pi_en_has_ref" = 0 ]; then
      pi_en_origin_ref="\$(pi_en_origin_value requested_ref || pi_en_origin_value ref || true)"
      if [ -n "\$pi_en_origin_ref" ]; then
        pi_en_extra_args+=(--ref "\$pi_en_origin_ref")
      fi
    fi
  fi
fi
if [ "\$pi_en_has_url" = 0 ] && [ "\$pi_en_has_ref" = 0 ] && [ "\$pi_en_has_archive_source" = 0 ] && [ "\${#pi_en_extra_args[@]}" -eq 0 ]; then
  echo "pi-en-update: no usable stored Git install origin found; pass --url URL --ref REF" >&2
  exit 1
fi
export PI_EN_INSTALL_UPDATE_WRAPPER=1
export PI_EN_INSTALL_PREFER_REMOTE=1
exec /usr/bin/env bash "\$pi_en_share_dir/scripts/pi-en-install-non-nix" --prefix "\$pi_en_prefix" "\${pi_en_extra_args[@]}" "\$@"
EOF
  chmod +x "$bin_dir/pi-en-update"
}

cleanup_temp_source() {
  [ -z "$temp_source_dir" ] || rm -rf "$temp_source_dir"
}

normalize_git_url() {
  local url="$1" local_path
  case "$url" in
    file://*)
      local_path="${url#file://}"
      if [ -d "$local_path" ]; then
        printf 'file://%s\n' "$(cd "$local_path" && pwd -P)"
      else
        printf '%s\n' "$url"
      fi
      ;;
    /*|./*|../*)
      if [ -d "$url" ]; then
        printf '%s\n' "$(cd "$url" && pwd -P)"
      else
        printf '%s\n' "$url"
      fi
      ;;
    *) printf '%s\n' "$url" ;;
  esac
}

ls_remote_ref_exists() {
  local kind="$1" url="$2" ref="$3" pattern
  case "$kind" in
    heads) pattern="refs/heads/$ref" ;;
    tags) pattern="refs/tags/$ref" ;;
    *) return 2 ;;
  esac
  git ls-remote --exit-code "$url" "$pattern" >/dev/null 2>&1
}

git_resolved_url=""
git_resolved_ref_type=""
git_resolved_commit=""

fetch_git_source_root() {
  local normalized_url ref branch commit branch_exists=0 tag_exists=0 checkout_ref
  if [ -z "$remote_ref" ]; then
    echo "pi-en-install-non-nix: --url requires --ref" >&2
    return 2
  fi
  normalized_url="$(normalize_git_url "$git_url")"
  temp_source_dir="$(mktemp -d)"
  trap cleanup_temp_source EXIT
  git init -q "$temp_source_dir/repo"
  git -C "$temp_source_dir/repo" remote add origin "$normalized_url"

  ref="$remote_ref"
  if [[ "$ref" == *@* ]]; then
    commit="${ref%%@*}"
    branch="${ref#*@}"
    if [ -z "$commit" ] || [ -z "$branch" ]; then
      echo "pi-en-install-non-nix: --ref COMMIT@BRANCH requires both parts" >&2
      return 2
    fi
    git -C "$temp_source_dir/repo" fetch --no-tags origin \
      "+refs/heads/$branch:refs/remotes/origin/pi-en-install-branch" >/dev/null
    if ! git -C "$temp_source_dir/repo" cat-file -e "$commit^{commit}" 2>/dev/null; then
      echo "pi-en-install-non-nix: commit not found after fetching branch: $commit" >&2
      return 1
    fi
    if ! git -C "$temp_source_dir/repo" merge-base --is-ancestor "$commit" refs/remotes/origin/pi-en-install-branch; then
      echo "pi-en-install-non-nix: commit $commit is not reachable from branch $branch" >&2
      return 1
    fi
    checkout_ref="$commit"
    git_resolved_ref_type="commit@branch"
  else
    if ls_remote_ref_exists heads "$normalized_url" "$ref"; then branch_exists=1; fi
    if ls_remote_ref_exists tags "$normalized_url" "$ref"; then tag_exists=1; fi
    if [ "$branch_exists" = "1" ] && [ "$tag_exists" = "1" ]; then
      echo "pi-en-install-non-nix: ambiguous ref '$ref' exists as both branch and tag; use COMMIT@BRANCH or rename the ref" >&2
      return 1
    elif [ "$branch_exists" = "1" ]; then
      git -C "$temp_source_dir/repo" fetch --no-tags origin \
        "+refs/heads/$ref:refs/remotes/origin/pi-en-install-ref" >/dev/null
      checkout_ref="refs/remotes/origin/pi-en-install-ref"
      git_resolved_ref_type="branch"
    elif [ "$tag_exists" = "1" ]; then
      git -C "$temp_source_dir/repo" fetch --no-tags origin \
        "+refs/tags/$ref:refs/tags/pi-en-install-ref" >/dev/null
      checkout_ref="refs/tags/pi-en-install-ref"
      git_resolved_ref_type="tag"
    else
      echo "pi-en-install-non-nix: ref '$ref' was not found as a branch or tag in $normalized_url" >&2
      return 1
    fi
  fi

  git -C "$temp_source_dir/repo" -c advice.detachedHead=false checkout -q --detach "$checkout_ref"
  git_resolved_url="$normalized_url"
  git_resolved_commit="$(git -C "$temp_source_dir/repo" rev-parse HEAD)"
  source_root="$temp_source_dir/repo"
}

remote_archive_url() {
  if [ -n "$artifact_url" ]; then
    printf '%s\n' "$artifact_url"
    return 0
  fi
  if [ -z "$remote_ref" ]; then
    echo "pi-en-install-non-nix: remote install requires --ref or --artifact-url" >&2
    return 1
  fi
  case "$remote_repo" in
    */*) ;;
    *) echo "pi-en-install-non-nix: --repo must use OWNER/REPO form" >&2; return 2 ;;
  esac
  printf 'https://codeload.github.com/%s/tar.gz/%s\n' "$remote_repo" "$remote_ref"
}

copy_or_download() {
  local url="$1" destination="$2"
  case "$url" in
    file://*) cp "${url#file://}" "$destination" ;;
    /*|./*|../*) cp "$url" "$destination" ;;
    *)
      if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$url" -o "$destination"
      elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$destination" "$url"
      else
        echo "pi-en-install-non-nix: remote install requires curl or wget" >&2
        return 127
      fi
      ;;
  esac
}

fetch_source_root() {
  local url archive unpack_dir
  url="$(remote_archive_url)"
  temp_source_dir="$(mktemp -d)"
  trap cleanup_temp_source EXIT
  archive="$temp_source_dir/payload.tar"
  unpack_dir="$temp_source_dir/unpacked"
  mkdir -p "$unpack_dir"
  copy_or_download "$url" "$archive"
  tar -xf "$archive" -C "$unpack_dir"
  source_root="$(find_unpacked_source_root "$unpack_dir")"
}

write_origin_metadata() {
  local source_kind="$1" source_url="$2" checksum="" installed_at
  installed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  case "$source_kind" in
    git)
      {
        printf 'source=git\n'
        printf 'url=%s\n' "$git_resolved_url"
        printf 'requested_ref=%s\n' "$remote_ref"
        printf 'ref=%s\n' "$remote_ref"
        printf 'resolved_ref_type=%s\n' "$git_resolved_ref_type"
        printf 'resolved_commit=%s\n' "$git_resolved_commit"
        printf 'installed_at=%s\n' "$installed_at"
      } > "$origin_file"
      ;;
    remote)
      if command -v sha256sum >/dev/null 2>&1 && [ -n "$source_url" ]; then
        case "$source_url" in
          file://*) checksum="$(sha256sum "${source_url#file://}" 2>/dev/null | awk '{print $1}' || true)" ;;
          /*|./*|../*) checksum="$(sha256sum "$source_url" 2>/dev/null | awk '{print $1}' || true)" ;;
        esac
      fi
      {
        printf 'source=archive\n'
        printf 'repository=%s\n' "$remote_repo"
        printf 'requested_ref=%s\n' "$remote_ref"
        printf 'ref=%s\n' "$remote_ref"
        printf 'artifact_url=%s\n' "$source_url"
        printf 'installed_at=%s\n' "$installed_at"
        [ -z "$checksum" ] || printf 'sha256=%s\n' "$checksum"
      } > "$origin_file"
      ;;
    *)
      rm -f "$origin_file"
      ;;
  esac
}

if [ "$uninstall" = "1" ]; then
  run_uninstall
  exit 0
fi

if [ "$check_deps" = "1" ]; then
  check_host_dependencies
fi

source_kind="local"
source_url=""
if [ -n "$git_url" ]; then
  source_kind="git"
  source_url="$(normalize_git_url "$git_url")"
  fetch_git_source_root
elif [ "$prefer_remote" = "1" ] && { [ -n "$remote_ref" ] || [ -n "$artifact_url" ]; }; then
  source_kind="remote"
  source_url="$(remote_archive_url)"
  fetch_source_root
elif source_root="$(find_source_root)"; then
  :
elif [ -n "$remote_ref" ] || [ -n "$artifact_url" ]; then
  source_kind="remote"
  source_url="$(remote_archive_url)"
  fetch_source_root
else
  echo "pi-en-install-non-nix: could not find pi-en release/source layout" >&2
  echo "pi-en-install-non-nix: expected scripts/, role-manager/, and pi-skill-templates/" >&2
  echo "pi-en-install-non-nix: pass --ref REF or --artifact-url URL to bootstrap from an archive" >&2
  exit 1
fi
mkdir -p "$bin_dir" "$share_dir" "$completion_dir"
remove_obsolete_commands
rm -rf "$share_dir/scripts" "$share_dir/role-manager" "$share_dir/pi-skill-templates"
cp -R "$source_root/scripts" "$share_dir/scripts"
cp -R "$source_root/role-manager" "$share_dir/role-manager"
cp -R "$source_root/pi-skill-templates" "$share_dir/pi-skill-templates"
chmod +x "$share_dir/scripts"/pi-en-coord-* \
  "$share_dir/scripts/pi-en-bootstrap-coordination" \
  "$share_dir/scripts/pi-en-bwrap" \
  "$share_dir/scripts/pi-en-launcher" \
  "$share_dir/scripts/pien" \
  "$share_dir/scripts/pi-en-serial-roles" \
  "$share_dir/scripts/pi-en-install-non-nix"
/usr/bin/env bash "$share_dir/scripts/pien" completion bash > "$completion_dir/pien"

for name in "${command_names[@]}"; do
  case "$name" in
    pi-en|pi-en-shell) install_wrapper "$name" pi-en-launcher ;;
    pi-en-update|pi-en-uninstall) ;;
    *) install_wrapper "$name" "$name" ;;
  esac
done
install_update_wrapper
install_uninstall_wrapper
write_origin_metadata "$source_kind" "$source_url"
write_manifest

echo "Installed pi-en host-runtime commands to $bin_dir"
echo "Installed support files to $share_dir"
echo "Add $bin_dir to PATH if needed. Uninstall with: $bin_dir/pi-en-uninstall"
