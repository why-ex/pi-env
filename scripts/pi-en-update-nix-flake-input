#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: pi-en-update [--url URL] [--ref REF]

Update the pi-en flake input for a project using pi-en.lib.mkPiShell.
Omitted source parts are left unchanged; with no options, flake.nix is
left unchanged and the pi-en lock input is refreshed.

Options:
  --url URL   Set the pi-en input source URL.
  --ref REF   Set a Git ref. COMMIT@BRANCH becomes a Git flake URL with
              both ref=BRANCH and rev=COMMIT.
  -h, --help  Show this help.
USAGE
}

fail() {
  echo "pi-en-update: $*" >&2
  exit 1
}

if [ "${PI_EN_NIX_SHELL:-}" != "1" ]; then
  fail "refusing to update outside a Pi-en-enabled Nix shell"
fi

input_name="${PI_EN_FLAKE_INPUT_NAME:-pi-en}"
url=""
ref=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --url)
      [ "$#" -ge 2 ] || fail "--url requires a value"
      url="$2"
      shift 2
      ;;
    --ref)
      [ "$#" -ge 2 ] || fail "--ref requires a value"
      ref="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --prefix|--uninstall|--yes|--system|--user|--install-dir)
      fail "unsupported Nix-shell updater option: $1"
      ;;
    *)
      fail "unsupported option: $1"
      ;;
  esac
done

find_flake_root() {
  local dir
  dir="$(pwd -P)"
  while :; do
    if [ -f "$dir/flake.nix" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [ "$dir" != / ] || return 1
    dir="$(dirname "$dir")"
  done
}

run_lock_update() {
  cd "$flake_root"
  if ! nix flake update "$input_name"; then
    nix flake lock --update-input "$input_name"
  fi
}

flake_root="$(find_flake_root)" || fail "could not find flake.nix from current directory"
flake_file="$flake_root/flake.nix"

if [ -z "$url$ref" ]; then
  echo "pi-en-update: no --url or --ref specified; refreshing lock"
  run_lock_update
  exit 0
fi

current_url="$(node - "$flake_file" "$input_name" <<'NODE'
const { readFileSync } = require('node:fs');
const [path, name] = process.argv.slice(2);
const text = readFileSync(path, 'utf8');
const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const patterns = [
  new RegExp(`^[ \\t]*(?:inputs\\.)?${esc}\\.url[ \\t]*=[ \\t]*"([^"]*)"[ \\t]*;`, 'm'),
  new RegExp(`^[ \\t]*"${esc}"\\.url[ \\t]*=[ \\t]*"([^"]*)"[ \\t]*;`, 'm'),
];
for (const pattern of patterns) {
  const match = text.match(pattern);
  if (match) {
    console.log(match[1]);
    process.exit(0);
  }
}
process.exit(1);
NODE
)" || fail "unsupported or dynamic pi-en input definition; edit $flake_file manually"

strip_ref_rev_query() {
  local value="$1" base query part rest=""
  case "$value" in
    *\?*)
      base="${value%%\?*}"
      query="${value#*\?}"
      ;;
    *)
      printf '%s\n' "$value"
      return 0
      ;;
  esac
  while [ -n "$query" ]; do
    part="${query%%&*}"
    if [ "$part" = "$query" ]; then
      query=""
    else
      query="${query#*&}"
    fi
    case "$part" in
      ref=*|rev=*) ;;
      *)
        if [ -z "$rest" ]; then rest="$part"; else rest="$rest&$part"; fi
        ;;
    esac
  done
  if [ -n "$rest" ]; then
    printf '%s?%s\n' "$base" "$rest"
  else
    printf '%s\n' "$base"
  fi
}

extract_ref_rev_query() {
  local value="$1" query part selector=""
  case "$value" in
    *\?*) query="${value#*\?}" ;;
    *) return 0 ;;
  esac
  while [ -n "$query" ]; do
    part="${query%%&*}"
    if [ "$part" = "$query" ]; then
      query=""
    else
      query="${query#*&}"
    fi
    case "$part" in
      ref=*|rev=*)
        if [ -z "$selector" ]; then selector="$part"; else selector="$selector&$part"; fi
        ;;
    esac
  done
  [ -z "$selector" ] || printf '%s\n' "$selector"
}

has_ref_rev_query() {
  case "$1" in
    *\?ref=*|*\?rev=*|*\&ref=*|*\&rev=*) return 0 ;;
    *) return 1 ;;
  esac
}

append_query() {
  local base="$1" query="$2"
  if [ -z "$query" ]; then
    printf '%s\n' "$base"
  elif [ -z "$base" ]; then
    printf '%s\n' "$query"
  else
    case "$base" in
      *\?*) printf '%s&%s\n' "$base" "$query" ;;
      *) printf '%s?%s\n' "$base" "$query" ;;
    esac
  fi
}

base_url="${url:-$(strip_ref_rev_query "$current_url") }"
# Trim the intentional command-substitution fallback space if used.
base_url="${base_url% }"
base_url="$(strip_ref_rev_query "$base_url")"

if [ -n "$ref" ]; then
  case "$ref" in
    *@*)
      commit="${ref%@*}"
      branch="${ref#*@}"
      [ -n "$commit" ] && [ -n "$branch" ] || fail "COMMIT@BRANCH ref must include both parts"
      case "$base_url" in
        git+*) ;;
        *) base_url="git+$base_url" ;;
      esac
      new_url="$(append_query "$base_url" "ref=$branch&rev=$commit")"
      ;;
    *)
      new_url="$(append_query "$base_url" "ref=$ref")"
      ;;
  esac
elif [ -n "$url" ] && has_ref_rev_query "$url"; then
  new_url="$url"
else
  new_url="$(append_query "$base_url" "$(extract_ref_rev_query "$current_url")")"
fi

if [ "$new_url" = "$current_url" ]; then
  echo "pi-en-update: pi-en input already uses $new_url; refreshing lock"
fi

export PI_EN_UPDATE_FLAKE_FILE="$flake_file"
export PI_EN_UPDATE_INPUT_NAME="$input_name"
export PI_EN_UPDATE_NEW_URL="$new_url"
node <<'NODE'
const { readFileSync, writeFileSync } = require('node:fs');
const path = process.env.PI_EN_UPDATE_FLAKE_FILE;
const name = process.env.PI_EN_UPDATE_INPUT_NAME;
const newUrl = process.env.PI_EN_UPDATE_NEW_URL;
const text = readFileSync(path, 'utf8');
const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const patterns = [
  new RegExp(`(^[ \\t]*(?:inputs\\.)?${esc}\\.url[ \\t]*=[ \\t]*")([^"]*)("[ \\t]*;)`, 'm'),
  new RegExp(`(^[ \\t]*"${esc}"\\.url[ \\t]*=[ \\t]*")([^"]*)("[ \\t]*;)`, 'm'),
];
for (const pattern of patterns) {
  if (pattern.test(text)) {
    const next = text.replace(pattern, (_match, prefix, _oldUrl, suffix) => `${prefix}${newUrl}${suffix}`);
    if (next !== text) writeFileSync(path, next);
    process.exit(0);
  }
}
console.error(`unsupported or dynamic ${name} input definition; edit ${path} manually`);
process.exit(1);
NODE

run_lock_update
